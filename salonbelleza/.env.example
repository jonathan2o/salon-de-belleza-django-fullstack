# ============================================
# Variables de entorno para PRODUCCIÓN
# Copiar a ".env" y completar los valores.
# El script deploy/deploy.sh genera este
# archivo automáticamente en el VPS.
# ============================================

# Django
DJANGO_SECRET_KEY=GENERA_UNA_CLAVE_SEGURA_EN_EL_SERVIDOR
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=salonestilo.shop,www.salonestilo.shop
CSRF_TRUSTED_ORIGINS=https://salonestilo.shop,https://www.salonestilo.shop

# CORS (con API_BASE relativo no es necesario en producción)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DB_NAME=salonbelleza_db
DB_USER=jonathan_rodriguez
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
DB_HOST=localhost
DB_PORT=5432
